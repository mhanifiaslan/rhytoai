<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Yuz okuma. Apple bu metni izin diyalogunda AYNEN gosteriyor ve
	     belirsiz gerekce tek basina red sebebi (Guideline 5.1.1). Metin ne
	     yapildigini VE ne yapilmadigini soyluyor: kare cihazda islenir,
	     yuklenmez, saklanmaz. -->
		<key>NSContactsUsageDescription</key>
	<string>Rehber eşleşmesini açarsan numaralar cihazında özetlenir; rehberin sunucuya gönderilmez.</string>
<key>NSCameraUsageDescription</key>
	<string>Yüz okuma için kameraya erişim gerekiyor. Görüntü yalnızca cihazında işlenir; hiçbir yere gönderilmez ve saklanmaz.</string>
	<!-- iOS 14+ sistem seçicisi (PHPicker) bu izni sormaz; anahtar eski
	     surumler ve olasi geri donusler icin duruyor. Metin ayni sozu
	     veriyor: fotograf cihazda islenir, yuklenmez. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Yüz okuma için galeriden fotoğraf seçebilirsin. Fotoğraf yalnızca cihazında işlenir; hiçbir yere gönderilmez ve saklanmaz.</string>
	<!-- Google ile Giris (iOS). Iki parca da GEREKLI ve ikisi de buradan
	     okunur; Dart tarafindan verilemez:

	     CFBundleURLTypes -> isletim sisteminin geri donus URL semasi. Google
	     tarayicida oturumu acip uygulamaya bu sema ile donuyor; kayitli
	     degilse iOS donusu hicbir yere yonlendiremez ve giris YARIDA kalir.
	     Deger GoogleService-Info.plist'teki REVERSED_CLIENT_ID ile BIREBIR ayni.

	     GIDClientID -> iOS OAuth istemci kimligi (ayni dosyadaki CLIENT_ID).

	     ⚠️ Ikisi de bundle ai.rytho icin uretildi. Firebase'de kayit bir kez
	     app.rytho diye acildi (yazim hatasi) ve o plist sessiz bir tuzakti:
	     FirebaseApp.configure() uyusmazligi HATA degil UYARI ile geciyor,
	     sonra App Check, giris ve push tek tek bozuluyordu. Bu degerler
	     degistirilecekse kaynak DAIMA GoogleService-Info.plist olmali. -->
	<key>GIDClientID</key>
	<string>770582338651-gj3mhjnnibvd0jd4ur3o7hbsq81lq9nh.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.770582338651-gj3mhjnnibvd0jd4ur3o7hbsq81lq9nh</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Rytho</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>rytho</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Ihracat uyumlulugu. Uygulama YALNIZ isletim sisteminin sagladigi
	     HTTPS/TLS kullaniyor; rehber eslesmesindeki SHA-256 ise OZETLEME,
	     sifreleme degil — ikisi de muaf. Bu anahtar olmazsa App Store
	     Connect HER TestFlight yuklemesinde ihracat sorusunu yeniden
	     soruyor ve dagitimi bekletiyor. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Uzak bildirim. Android tarafinda karsiligi manifest izni; iOS'ta
	     BU anahtar VE entitlements'taki aps-environment BIRLIKTE gerekir.
	     Biri eksikken push SESSIZCE calismaz: jeton alinir, bildirim gelmez. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
